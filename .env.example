# Copy to .env only if your setup loads it; the course default is exporting these in your shell.
OPENROUTER_API_KEY=
COURSEMATE_MODEL=google/gemini-3.8-flash
COURSEMATE_LOG_PATH=logs/usage.jsonl
COURSEMATE_ANSWER_LOG=logs/answers.jsonl
COURSEMATE_EMBED_MODEL=openai/text-embedding-3-small
# 1 = no key, no network, stand-in models (tests and CI). 0 or unset = real models.
COURSEMATE_OFFLINE=0
